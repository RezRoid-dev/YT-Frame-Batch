{
  "manifest_version": 3,
  "name": "DrComp Frame Batch",
  "version": "2.4.0",
  "description": "ChatGPT and Google Flow image batches in a companion side panel.",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.blob.core.windows.net/*",
    "https://*.openai.com/*",
    "https://labs.google/*",
    "https://flow.google/*",
    "https://flow.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open DrComp Frame Batch"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://labs.google/*",
        "https://flow.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "optional_permissions": [
    "contentSettings"
  ]
}
